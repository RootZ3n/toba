# Toba — Ice Age Career Agent
#
# Direct Xiaomi MiMo (preferred over OpenRouter)
TOBA_PROVIDER=xiaomi
TOBA_MODEL=mimo-v2.5

# MiMo API key — same key as the rest of the lab
# Resolved via: TOBA_XIAOMI_API_KEY > CURSUS_XIAOMI_API_KEY > TOBA_PROVIDER_API_KEY > MIMO_API_KEY
TOBA_XIAOMI_API_KEY=your-api-key-here
TOBA_PROVIDER_API_KEY=your-api-key-here

# Override base URL (optional — defaults to https://api.xiaomimimo.com/v1)
# TOBA_PROVIDER_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ── Additional provider keys ──────────────────────────────────────────
# Set the provider-specific key for the active TOBA_PROVIDER.
# TOBA_PROVIDER_API_KEY is the fallback for any provider.

# OpenAI
# TOBA_PROVIDER=openai
# TOBA_MODEL=gpt-4o
# TOBA_OPENAI_API_KEY=

# Anthropic
# TOBA_PROVIDER=anthropic
# TOBA_MODEL=claude-sonnet-4-6-20250514
# TOBA_ANTHROPIC_API_KEY=

# OpenRouter
# TOBA_PROVIDER=openrouter
# TOBA_MODEL=deepseek/deepseek-v4-pro
# TOBA_OPENROUTER_API_KEY=
# TOBA_OPENROUTER_REFERER=
# TOBA_OPENROUTER_TITLE=Toba

# Ollama (local — no key needed)
# TOBA_PROVIDER=ollama
# TOBA_MODEL=llama3

# Google/Gemini
# TOBA_PROVIDER=google
# TOBA_MODEL=gemini-2.0-flash
# TOBA_GOOGLE_API_KEY=

# Groq
# TOBA_PROVIDER=groq
# TOBA_MODEL=llama-3.3-70b-versatile
# TOBA_GROQ_API_KEY=

# Mistral
# TOBA_PROVIDER=mistral
# TOBA_MODEL=mistral-large-latest
# TOBA_MISTRAL_API_KEY=

# Together
# TOBA_PROVIDER=together
# TOBA_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# TOBA_TOGETHER_API_KEY=

# DeepSeek
# TOBA_PROVIDER=deepseek
# TOBA_MODEL=deepseek-chat
# TOBA_DEEPSEEK_API_KEY=

# ── Mode ──────────────────────────────────────────────────────────────
# TOBA_LOCAL_ONLY=false
