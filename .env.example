# Toba — Ice Age Career Agent
#
# Direct Xiaomi MiMo (preferred over OpenRouter)
TOBA_PROVIDER=xiaomi
TOBA_MODEL=mimo-v2.5

# MiMo API key — same key as the rest of the lab
# Resolved via: TOBA_XIAOMI_API_KEY > CURSUS_XIAOMI_API_KEY > TOBA_PROVIDER_API_KEY > MIMO_API_KEY
TOBA_XIAOMI_API_KEY=your-api-key-here
TOBA_PROVIDER_API_KEY=your-api-key-here

# Override base URL (optional — defaults to https://api.xiaomimimo.com/v1)
# TOBA_PROVIDER_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
