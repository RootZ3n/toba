{
  "name": "toba",
  "version": "5.0.0",
  "description": "Toba — Career Transformation Platform (standalone). Self-contained Fastify + SQLite service with native provider/model selection.",
  "type": "module",
  "author": "RootZ3n <rootz3n@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RootZ3n/toba.git"
  },
  "homepage": "https://github.com/RootZ3n/toba#readme",
  "keywords": [
    "career",
    "transformation",
    "ai",
    "mimo",
    "fastify",
    "sqlite",
    "job-search",
    "resume",
    "career-coaching"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/web && cp -r src/web/. dist/web/",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "toba:setup": "bash scripts/toba-setup.sh",
    "toba:setup:noninteractive": "bash scripts/toba-setup.sh --non-interactive",
    "verify": "bash scripts/verify-standalone.sh",
    "verify:tailscale": "bash scripts/verify-tailscale-ready.sh"
  },
  "dependencies": {
    "velum-ai": "file:./vendor/velum-ai",
    "@fastify/cors": "^9.0.1",
    "better-sqlite3": "^9.4.3",
    "fastify": "^4.28.0"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/RootZ3n/toba/issues"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.5",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
