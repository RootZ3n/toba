[Unit]
Description=Toba — Career Transformation Platform (Standalone)
After=network.target
Wants=network.target

[Service]
Type=simple
User=zen
WorkingDirectory=/mnt/ai/cursus
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

# Toba is standalone. TOBA_* env vars preferred, CURSUS_* accepted as fallback.
Environment=NODE_ENV=production
Environment=TOBA_PORT=18815
Environment=TOBA_HOST=127.0.0.1
Environment=TOBA_DB_PATH=/mnt/ai/cursus/state/cursus.db
# Provider defaults: unconfigured. Set in .env to enable Peh chat.
Environment=TOBA_PROVIDER=none
Environment=TOBA_MODEL=none
Environment=TOBA_LOCAL_ONLY=false
EnvironmentFile=-/mnt/ai/cursus/.env

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/mnt/ai/cursus/state

[Install]
WantedBy=multi-user.target
